{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.entry.test.ts",
    "src/**/*.tsx",
    "src/__mocks__/**/*.ts",
    "scripts/**/*.test.ts",
    "node_modules/iina-plugin-definition/iina/**/*.d.ts"
  ]
}
