{
  "compilerOptions": {
    "lib": ["es6", "es7", "esnext"],
    "sourceMap": false,
    "target": "es6",
    "module": "es6",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [],
    "typeRoots": ["./node_modules/@types", "./node_modules/iina-plugin-definition"]
  },
  "include": [
    "src/index.ts",
    "src/global.ts",
    "src/types.ts",
    "src/preferences.ts",
    "src/pref-store.ts",
    "src/playlist.ts",
    "./node_modules/iina-plugin-definition/iina/**/*.d.ts"
  ],
  "compileOnSave": false
}
