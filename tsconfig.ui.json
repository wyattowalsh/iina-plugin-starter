{
  "compilerOptions": {
    "lib": ["es6", "es7", "esnext", "dom"],
    "jsx": "react-jsx",
    "sourceMap": false,
    "target": "es6",
    "module": "es6",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/ui/**/*", "src/types.ts"],
  "compileOnSave": false
}
