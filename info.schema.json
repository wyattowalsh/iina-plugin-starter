{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IINA Plugin Manifest",
  "description": "Schema for IINA plugin Info.json manifests",
  "type": "object",
  "required": ["name", "identifier", "version", "entry", "author"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference (for IDE validation)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable plugin name shown in IINA's UI"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "description": "Reverse-DNS bundle identifier (e.g. com.example.my-plugin)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "description": "SemVer version string"
    },
    "description": {
      "type": "string",
      "description": "Short description of what the plugin does"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "entry": {
      "type": "string",
      "description": "Path to per-player entry script (relative to plugin root)"
    },
    "globalEntry": {
      "type": "string",
      "minLength": 1,
      "description": "Path to global entry script (runs once at IINA launch)"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["show-osd", "video-overlay", "show-alert", "network-request", "file-system"]
      },
      "uniqueItems": true,
      "description": "IINA permissions the plugin requires"
    },
    "allowedDomains": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Domains the plugin may make network requests to"
    },
    "preferencesPage": {
      "type": "string",
      "description": "Path to preferences HTML page"
    },
    "preferenceDefaults": {
      "type": "object",
      "additionalProperties": true,
      "description": "Default values for plugin preferences"
    },
    "helpPage": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a help page HTML file, or an external URL stored as a plain string"
    },
    "subtitleProviders": {
      "type": "array",
      "description": "Subtitle provider registrations",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": { "type": "string" }
      }
    },
    "localized": {
      "type": "object",
      "description": "Per-locale display strings keyed by language tag",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "sidebarTab": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "sidebarTab": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["name"],
      "additionalProperties": false,
      "description": "Sidebar tab configuration"
    },
    "ghRepo": {
      "type": "string",
      "pattern": "^[\\w-]+/[\\w-]+$",
      "description": "GitHub repo for auto-update (user/repo format)"
    },
    "ghVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "GitHub release version counter for auto-update"
    }
  }
}
