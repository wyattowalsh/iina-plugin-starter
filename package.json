{
  "name": "iina-plugin-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "parcel watch",
    "dev:reload": "node scripts/dev-reload.mjs",
    "build": "rm -rf dist .parcel-cache && parcel build --target entry && parcel build --target globalEntry && parcel build --target overlay && parcel build --target sidebar && parcel build --target standalone && node scripts/postprocess-webviews.mjs",
    "link": "iina-plugin link .",
    "unlink": "iina-plugin unlink .",
    "pack": "iina-plugin pack .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{ts,tsx,mjs}' 'scripts/**/*.{ts,tsx,mjs}' --max-warnings 0",
    "format": "prettier --write 'src/**/*.{ts,tsx,html,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,html,css}'",
    "typecheck": "tsc --noEmit -p tsconfig.entry.json && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.tests.json",
    "validate": "node scripts/validate-info.mjs",
    "prepare": "husky"
  },
  "targets": {
    "main": false,
    "entry": {
      "distDir": "./dist/",
      "source": "src/index.ts",
      "isLibrary": false
    },
    "globalEntry": {
      "distDir": "./dist/",
      "source": "src/global.ts",
      "isLibrary": false
    },
    "overlay": {
      "distDir": "./dist/ui/overlay/",
      "source": "src/ui/overlay/index.html",
      "publicUrl": "./"
    },
    "sidebar": {
      "distDir": "./dist/ui/sidebar/",
      "source": "src/ui/sidebar/index.html",
      "publicUrl": "./"
    },
    "standalone": {
      "distDir": "./dist/ui/standalone/",
      "source": "src/ui/standalone/index.html",
      "publicUrl": "./"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^22.15.32",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "iina-plugin-definition": "^0.99.3",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.0.0",
    "parcel": "^2.14.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "browserslist": "safari >= 9",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,md}": [
      "prettier --write"
    ]
  }
}
